#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinks to find the real script location, then walk up to find playbooks/
find_root() {
    local dir
    dir="$(cd "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
    while [[ ! -d "$dir/playbooks" ]]; do
        dir="$(cd "$dir/.." && pwd)"
        if [[ "$dir" == "/" ]]; then
            echo "Error: dotfiles repo not found" >&2
            exit 1
        fi
    done
    echo "$dir"
}

detect_platform() {
    if [[ -f /etc/os-release ]]; then
        . /etc/os-release
        case "$ID" in
            ubuntu|debian)  echo "ubuntu" ;;
            alpine)         echo "alpine" ;;
            arch)           echo "arch" ;;
            *)              echo "unknown" ;;
        esac
    elif [[ "$(uname)" == "Darwin" ]]; then
        echo "macos"
    else
        echo "unknown"
    fi
}

main() {
    local root
    root="$(find_root)"

    local platform="${1:-$(detect_platform)}"
    local playbook="$root/playbooks/${platform}.yml"

    if [[ ! -f "$playbook" ]]; then
        echo "Error: no playbook for platform '$platform'" >&2
        echo "Available: $(ls "$root/playbooks" | sed 's/\.yml$//' | tr '\n' ' ')" >&2
        exit 1
    fi

    echo "Running Ansible playbook: $playbook"
    uvx --from ansible-core ansible-playbook -c local -i localhost, "$playbook"
}

main "$@"
